[Unit]
Description=Owner native browser backend (prototype)
After=persistency-fs.target mgu-browser-wifi.service
Wants=persistency-fs.target mgu-browser-wifi.service

[Service]
Type=simple
ExecStart=/usr/bin/node /var/opt/mgu-browser/current/runtime/launch.js
Restart=always
RestartSec=3
KillMode=control-group
TimeoutStopSec=20
# Full CPU access (no quota) and raised priority for Chromium's software
# rendering; no realtime class, so the stock HMI keeps its own scheduling.
MemoryAccounting=yes
MemoryLimit=1536M
CPUAccounting=yes
CPUShares=1024
Nice=-5
TasksMax=384
OOMScoreAdjust=0
Environment=HOME=/var/opt/mgu-browser/data
UMask=0077

[Install]
WantedBy=multi-user.target
