[Unit]
Description=Owner browser WLAN startup
RequiresMountsFor=/var/opt
After=persistency-fs.target wpa_supplicant.service mgu-uplink.service
Wants=persistency-fs.target wpa_supplicant.service

[Service]
Type=simple
ExecStart=/usr/bin/node /var/opt/mgu-browser/current/network/control.js
Group=root
RuntimeDirectory=mgu-browser-wifi
RuntimeDirectoryMode=0755
TimeoutStartSec=75
Restart=on-failure
RestartSec=5
StandardOutput=journal
StandardError=journal
Nice=10
UMask=0077

[Install]
WantedBy=multi-user.target
