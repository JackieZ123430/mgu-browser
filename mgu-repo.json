{
  "schema": 1,
  "apps": {
    "path": "apps/*",
    "manifest": "app.zh-CN.json",
    "mguHmi": [
      "ID7"
    ],
    "requires": {
      "mgu-browser": "0.16.0",
      "mgu-uplink": "0.7.3",
      "mgu-render": "0.6.11",
      "mgu-deploy": "0.7.17",
      "mgu-browser-engine": "0.1.0"
    },
    "build": {
      "python": "tools/build_store_zh.py",
      "args": [
        "{id}"
      ],
      "sdk": "oap-sdk",
      "network": true,
      "output": "dist/{id}@{version}.tgz",
      "shared": [
        "src",
        "assets",
        "localization",
        "tools/build_store.py",
        "tools/kit_shutdown.py"
      ]
    }
  }
}
